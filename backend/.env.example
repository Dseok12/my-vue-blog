# 서버
PORT=4000
NODE_ENV=development

# 프론트엔드 주소 (CORS 허용 대상, 쉼표로 여러 개 가능)
CLIENT_ORIGIN=http://localhost:3000

# MySQL 접속 정보
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_diary

# JWT
# 운영에서는 반드시 길고 예측 불가능한 값으로 바꾼다.
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# 로그인 / 회원가입 요청 제한 (같은 IP 가 N분 동안 최대 몇 번)
AUTH_RATE_WINDOW_MINUTES=15
AUTH_RATE_MAX=20
