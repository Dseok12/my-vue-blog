# 백엔드 환경 변수 예시 - `cp .env.example .env` 후 값을 채운다.
# .env 에는 비밀번호가 들어가므로 git 에 올리지 않는다. (이 예시 파일만 올린다)

# 서버
PORT=4000
NODE_ENV=development

# 허용할 프론트엔드 주소 (쉼표로 여러 개)
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_vue_blog

# 로그인 토큰 - 운영에서는 반드시 길고 무작위한 값으로 바꾼다.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 로그인 / 회원가입 요청 제한 (같은 IP 가 N분 동안 최대 몇 번)
AUTH_RATE_WINDOW_MINUTES=15
AUTH_RATE_MAX=20

# 관리자 이메일 (쉼표로 여러 개) / 신고 알림 받을 메일
ADMIN_EMAILS=
REPORT_EMAIL=

# 메일 발송 (비워 두면 실제로 보내지 않고 콘솔에만 남긴다)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 이미지 주소를 절대 경로로 주고 싶을 때만 (예: https://api.example.com)
PUBLIC_BASE_URL=
