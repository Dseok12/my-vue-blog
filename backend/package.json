{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "나만의 다양한 diary - 백엔드 API 서버",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --fresh && node src/db/seed.js",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "test:db": "node --test \"test-db/*.test.js\""
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
